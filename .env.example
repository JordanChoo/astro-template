# Directus CMS connection (all optional — template works without these)
DIRECTUS_URL=
DIRECTUS_TOKEN=
DIRECTUS_SITE_SLUG=

# Override base URL for Directus asset/image links
DIRECTUS_ASSET_BASE_URL=

# Local cache directory for CMS data (default: .cache)
CACHE_DIR=

# Set to "true" to fail the build when CMS is unreachable
DIRECTUS_REQUIRED=
