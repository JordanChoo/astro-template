---
/**
 * SEO Component
 *
 * Comprehensive SEO meta tags including Open Graph and Twitter cards.
 * Uses site config for defaults and templates.
 *
 * @example
 * ```astro
 * <SEO
 *   title="About Us"
 *   description="Learn about our company"
 *   type="website"
 * />
 * ```
 */

import siteConfig from '@/config/site';
import type { ImageMeta, BlogPostSeo } from '@/lib/content/types';

export interface Props {
  title: string;
  description?: string | undefined;
  canonicalUrl?: string | undefined;
  image?: ImageMeta | string | undefined;
  ogImage?: ImageMeta | string | undefined;
  twitterImage?: ImageMeta | string | undefined;
  imageWidth?: number | undefined;
  imageHeight?: number | undefined;
  noindex?: boolean | undefined;
  type?: 'website' | 'article' | undefined;
  twitterCreator?: string | undefined;
  seo?: BlogPostSeo | undefined;
}

const {
  title,
  description = siteConfig.seo.defaultDescription,
  canonicalUrl,
  image,
  ogImage: ogImageProp,
  twitterImage: twitterImageProp,
  imageWidth,
  imageHeight,
  noindex = false,
  type = 'website',
  twitterCreator,
  seo,
} = Astro.props;

const effectiveTitle = seo?.titleTag ?? title;
const effectiveDescription = seo?.metaDescription ?? description;
const fullTitle = siteConfig.seo.titleTemplate.replace('%s', effectiveTitle);

if (effectiveDescription && effectiveDescription.length > 160) {
  console.warn(
    `[SEO] Meta description for "${effectiveTitle}" is ${effectiveDescription.length} characters. ` +
      `Consider keeping it under 160 characters for optimal SEO.`
  );
}

const currentUrl = new URL(Astro.url.pathname, siteConfig.seo.siteUrl).href;
const canonical = seo?.canonicalUrl ?? canonicalUrl ?? currentUrl;
const robotsDirective = seo?.robots ?? (noindex ? 'noindex' : undefined);

function resolveImageUrl(img: string | undefined): string | undefined {
  if (!img) return undefined;
  if (img.startsWith('http://') || img.startsWith('https://')) {
    return img;
  }
  const path = img.startsWith('/') ? img : `/${img}`;
  return new URL(path, siteConfig.seo.siteUrl).href;
}

function extractImage(img: ImageMeta | string | undefined): {
  url?: string | undefined;
  width?: number | undefined;
  height?: number | undefined;
} {
  if (!img) return {};
  if (typeof img === 'string') return { url: resolveImageUrl(img) };
  return {
    url: resolveImageUrl(img.url),
    width: img.width,
    height: img.height,
  };
}

const primaryImage = extractImage(image);
const ogImageInfo = ogImageProp ? extractImage(ogImageProp) : primaryImage;
const twitterImageInfo = twitterImageProp ? extractImage(twitterImageProp) : ogImageInfo;

const ogImageUrl = ogImageInfo.url ?? resolveImageUrl(siteConfig.seo.ogImage);
const ogImageWidth =
  ogImageInfo.width ?? imageWidth ?? (primaryImage.url ? undefined : siteConfig.seo.ogImageWidth);
const ogImageHeight =
  ogImageInfo.height ??
  imageHeight ??
  (primaryImage.url ? undefined : siteConfig.seo.ogImageHeight);
const twitterImageUrl = twitterImageInfo.url ?? ogImageUrl;

function formatTwitterHandle(handle: string | undefined): string | undefined {
  if (!handle) return undefined;
  return handle.startsWith('@') ? handle : `@${handle}`;
}

const twitterSite = formatTwitterHandle(siteConfig.twitterHandle);
const twitterCreatorHandle = formatTwitterHandle(twitterCreator);
---

{/* Essential meta tags */}
<title>{fullTitle}</title>
<meta name="description" content={effectiveDescription} />
<link rel="canonical" href={canonical} />
<meta name="viewport" content="width=device-width, initial-scale=1" />

{/* Robots directive */}
{robotsDirective && <meta name="robots" content={robotsDirective} />}

{/* Open Graph tags */}
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={effectiveDescription} />
<meta property="og:url" content={canonical} />
<meta property="og:type" content={type} />
<meta property="og:site_name" content={siteConfig.name} />

{/* OG Image (only if available) */}
{ogImageUrl && <meta property="og:image" content={ogImageUrl} />}
{ogImageUrl && ogImageWidth && <meta property="og:image:width" content={String(ogImageWidth)} />}
{ogImageUrl && ogImageHeight && <meta property="og:image:height" content={String(ogImageHeight)} />}

{/* Twitter Card tags */}
<meta name="twitter:card" content={ogImageUrl ? 'summary_large_image' : 'summary'} />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={effectiveDescription} />
{twitterImageUrl && <meta name="twitter:image" content={twitterImageUrl} />}
{twitterSite && <meta name="twitter:site" content={twitterSite} />}
{twitterCreatorHandle && <meta name="twitter:creator" content={twitterCreatorHandle} />}
