---
/**
 * Individual Blog Post Page
 *
 * Renders a single blog post with PostLayout.
 * Supports dual rendering: CMS pre-rendered HTML or Astro native render.
 * Includes BlogPostingLD and BreadcrumbLD for structured data.
 */

import { getEntry, render } from 'astro:content';

import { getBlogPosts } from '@/lib/content/provider';
import type { BlogPost, BlogPostHeading } from '@/lib/content/types';

import PostLayout from '@/layouts/PostLayout.astro';
import SEO from '@/components/SEO.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import BlogPostingLD from '@/components/seo/BlogPostingLD.astro';
import BreadcrumbLD from '@/components/seo/BreadcrumbLD.astro';
import { calculateReadingTime } from '@/utils/reading-time';
import { getRelatedPosts } from '@/utils/related-posts';
import PostCard from '@/components/PostCard.astro';
import siteConfig from '@/config/site';

export async function getStaticPaths() {
  const allPosts = await getBlogPosts();

  return allPosts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

interface Props {
  post: BlogPost;
}

const { post } = Astro.props;

// Dual rendering: CMS pre-rendered HTML vs Astro native render
// eslint-disable-next-line @typescript-eslint/no-explicit-any
let ContentComponent: any = null;
let _headings: BlogPostHeading[] = [];

if (post.rendered) {
  _headings = post.rendered.headings;
} else {
  const entry = await getEntry('blog', post.slug);
  if (entry) {
    const rendered = await render(entry);
    ContentComponent = rendered.Content;
    _headings = rendered.headings.map((h) => ({
      depth: h.depth,
      slug: h.slug,
      text: h.text,
    }));
  }
}

// Reading time from raw markdown content
const readingTimeMinutes = calculateReadingTime(post.content);
const readingTime = `${readingTimeMinutes} min read`;

// Author resolution
const author = post.author ? await getEntry('team', post.author) : undefined;
const authorData = author
  ? { name: author.data.name, slug: author.data.slug }
  : { name: 'Unknown Author', slug: post.author || '' };

// Related posts
const allPosts = await getBlogPosts();
const relatedPosts = getRelatedPosts(post, allPosts, 3);

const relatedPostsWithAuthors = await Promise.all(
  relatedPosts.map(async (relatedPost) => {
    const relatedAuthor = relatedPost.author
      ? await getEntry('team', relatedPost.author)
      : undefined;
    return {
      post: relatedPost,
      author: relatedAuthor
        ? { name: relatedAuthor.data.name, slug: relatedAuthor.data.slug }
        : { name: 'Unknown Author', slug: relatedPost.author || '' },
    };
  })
);

const breadcrumbItems = [
  { name: 'Home', url: '/' },
  { name: 'Blog', url: '/blog/' },
  { name: post.title, url: `/blog/${post.slug}/` },
];

const normalizedTags = post.tags.map((tag) => tag.toLowerCase().replace(/\s+/g, '-'));
---

<PostLayout
  title={post.title}
  description={post.description}
  pubDate={post.pubDate}
  author={authorData}
  image={post.image}
  readingTime={readingTime}
  tags={normalizedTags}
  isDraft={post.isDraft}
>
  <Fragment slot="head">
    <SEO
      title={post.seo?.titleTag ?? post.title}
      description={post.seo?.metaDescription ?? post.description}
      image={post.image}
      type="article"
      seo={post.seo}
    />
    <BlogPostingLD
      headline={post.title}
      description={post.description}
      datePublished={post.pubDate.toISOString()}
      author={{
        name: authorData.name,
        url: authorData.slug ? `${siteConfig.seo.siteUrl}/team/${authorData.slug}/` : undefined,
      }}
      image={post.image}
    />
    <BreadcrumbLD items={breadcrumbItems} />
  </Fragment>

  <Breadcrumbs currentPath={Astro.url.pathname} />

  {
    post.rendered ? (
      <Fragment set:html={post.rendered.html} />
    ) : ContentComponent ? (
      <ContentComponent />
    ) : (
      <p>Content not available.</p>
    )
  }

  {/* Related Posts Section */}
  {
    relatedPostsWithAuthors.length > 0 && (
      <section class="mt-16 pt-12 border-t border-neutral-200">
        <h2 class="text-2xl font-bold text-neutral-900 mb-8">Related Posts</h2>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          {relatedPostsWithAuthors.map(({ post: relatedPost, author: relatedAuthor }) => (
            <PostCard
              slug={relatedPost.slug}
              title={relatedPost.title}
              description={relatedPost.description}
              pubDate={relatedPost.pubDate}
              author={relatedAuthor}
              tags={relatedPost.tags}
              image={relatedPost.image}
              isDraft={relatedPost.isDraft}
            />
          ))}
        </div>
      </section>
    )
  }
</PostLayout>
