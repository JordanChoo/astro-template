---
/**
 * Individual Blog Post Page
 *
 * Renders a single blog post with PostLayout.
 * Supports dual rendering: CMS pre-rendered HTML or Astro native render.
 * Includes BlogPostingLD and BreadcrumbLD for structured data.
 */

import { getEntry, render } from 'astro:content';

import { getBlogPosts } from '@/lib/content/provider';
import { resolveAuthorOrFallback } from '@/lib/content/authors';
import type { BlogPost } from '@/lib/content/types';

import PostLayout from '@/layouts/PostLayout.astro';
import SEO from '@/components/SEO.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import BlogPostingLD from '@/components/seo/BlogPostingLD.astro';
import BreadcrumbLD from '@/components/seo/BreadcrumbLD.astro';
import { calculateReadingTime } from '@/utils/reading-time';
import { getRelatedPosts } from '@/utils/related-posts';
import PostCard from '@/components/PostCard.astro';
import siteConfig from '@/config/site';

export async function getStaticPaths() {
  const allPosts = await getBlogPosts();
  const posts = import.meta.env.PROD ? allPosts.filter((post) => !post.isDraft) : allPosts;

  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

interface Props {
  post: BlogPost;
}

const { post } = Astro.props;

// CMS posts carry sanitized HTML. Local posts still use Astro's native renderer.
const localEntry = post.rendered ? undefined : await getEntry('blog', post.slug);
const localRender =
  localEntry && (localEntry.body ?? '') === post.content ? await render(localEntry) : undefined;
const LocalContent = localRender?.Content;

// Reading time from raw markdown content
const readingTimeMinutes = calculateReadingTime(post.content);
const readingTime = `${readingTimeMinutes} min read`;

const authorData = await resolveAuthorOrFallback(post.author);

// Related posts
const allPosts = await getBlogPosts();
const visiblePosts = import.meta.env.PROD
  ? allPosts.filter((candidate) => !candidate.isDraft)
  : allPosts;
const relatedPosts = getRelatedPosts(post, visiblePosts, 3);

const relatedPostsWithAuthors = await Promise.all(
  relatedPosts.map(async (relatedPost) => ({
    post: relatedPost,
    author: await resolveAuthorOrFallback(relatedPost.author),
  }))
);

const breadcrumbItems = [
  { name: 'Home', url: '/' },
  { name: 'Blog', url: '/blog/' },
  { name: post.title, url: `/blog/${post.slug}/` },
];

const normalizedTags = post.tags.map((tag) => tag.toLowerCase().replace(/\s+/g, '-'));
---

<PostLayout
  title={post.title}
  description={post.description}
  pubDate={post.pubDate}
  author={authorData}
  image={post.image}
  readingTime={readingTime}
  tags={normalizedTags}
  isDraft={post.isDraft}
>
  <Fragment slot="head">
    <SEO
      title={post.title}
      description={post.description}
      image={post.image}
      type="article"
      seo={post.seo}
    />
    <BlogPostingLD
      headline={post.title}
      description={post.description}
      datePublished={post.pubDate.toISOString()}
      author={{
        name: authorData.name,
        url: authorData.slug ? `${siteConfig.seo.siteUrl}/team/${authorData.slug}/` : undefined,
      }}
      image={post.image}
    />
    <BreadcrumbLD items={breadcrumbItems} />
  </Fragment>

  <Breadcrumbs currentPath={Astro.url.pathname} />

  {
    post.rendered ? (
      <Fragment set:html={post.rendered.html} />
    ) : LocalContent ? (
      <LocalContent />
    ) : (
      <p>Content not available.</p>
    )
  }

  {/* Related Posts Section */}
  {
    relatedPostsWithAuthors.length > 0 && (
      <section class="mt-16 pt-12 border-t border-neutral-200">
        <h2 class="text-2xl font-bold text-neutral-900 mb-8">Related Posts</h2>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          {relatedPostsWithAuthors.map(({ post: relatedPost, author: relatedAuthor }) => (
            <PostCard
              slug={relatedPost.slug}
              title={relatedPost.title}
              description={relatedPost.description}
              pubDate={relatedPost.pubDate}
              author={relatedAuthor}
              tags={relatedPost.tags}
              image={relatedPost.image}
              isDraft={relatedPost.isDraft}
            />
          ))}
        </div>
      </section>
    )
  }
</PostLayout>
